# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key used for task updates after role checks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Notifications and reports ----
# Resend (resend.com) API key, after verifying the pexeta.in domain there
RESEND_API_KEY=re_xxxxxxxx
# Sender shown on emails (must be on the verified domain)
EMAIL_FROM=Pexeta Ops <ops@pexeta.in>
# Public URL of the app, used for links in emails
APP_URL=https://ops.pexeta.in
# Google Chat space → Apps & integrations → Webhooks → Add webhook (optional)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...
# Any long random string; the same value goes into supabase/003_schedules.sql
CRON_SECRET=change-me-to-a-long-random-string
